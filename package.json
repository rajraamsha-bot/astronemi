{
  "name": "astronemi",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage --watchAll=false",
    "build:staging": "npm run typecheck && expo export --platform web --output-dir web-build-staging",
    "build:production": "npm run check:production && npm run typecheck && expo export --platform web --output-dir web-build-production",
    "check:production": "node scripts/check-production-ready.js",
    "check:audit": "node scripts/check-npm-audit.js",
    "check:portability": "node scripts/check-backend-portability.js",
    "check:rpc-auth": "node scripts/audit-rpc-auth.js",
    "check:cron": "node scripts/check-cron-functions.js",
    "check:eas": "node scripts/check-eas-placeholders.js",
    "prebuild:production": "npm run check:production",
    "consolidate:edge-functions": "bash scripts/consolidate-edge-functions.sh --i-understand-this-deletes-files",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:web:staging": "npm run build:staging && echo 'Web deployed to staging'",
    "deploy:web:production": "npm run build:production && echo 'Web deployed to production'",
    "test:smoke": "jest --config jest.config.js --testPathPattern=__tests__/e2e --coverage=false --watchAll=false",
    "test:ci": "jest --config jest.config.js --coverage --watchAll=false --ci --reporters=default",
    "typecheck": "tsc --noEmit",
    "db:migrate": "supabase db migrate",
    "db:backup": "supabase db dump --file backup_$(date +%Y%m%d_%H%M%S).sql",
    "supabase:functions:deploy": "supabase functions deploy",
    "supabase:functions:deploy:create-order": "supabase functions deploy create-razorpay-order",
    "supabase:functions:deploy:verify": "supabase functions deploy verify-payment",
    "supabase:functions:deploy:webhook": "supabase functions deploy razorpay-webhook"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.96.0",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.83.0",
    "astronomy-engine": "^2.1.19",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-iap": "^6.3.0",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.16",
    "expo-router": "^6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.0.6",
    "lucide-react-native": "^0.562.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.4",
    "react-native": "0.81.5",
    "react-native-agora": "^4.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "knip": "^6.4.1",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@babel/core": "^7.25.2",
    "@babel/generator": "^7.25.2",
    "@babel/template": "^7.25.2",
    "@babel/parser": "^7.25.2",
    "@babel/traverse": "^7.25.2",
    "uuid": "^11.1.1",
    "ws": "^8.18.0",
    "postcss": "^8.5.23",
    "tar": "^7.5.22",
    "minimatch": "^10.2.5",
    "test-exclude": "^8.0.0"
  },
  "private": true
}
