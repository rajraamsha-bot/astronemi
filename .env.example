# ============================================
# AstroNemi Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# CRITICAL:
#   - Only `EXPO_PUBLIC_*` variables are available in the client bundle.
#   - Variables WITHOUT that prefix live only in the Node.js process that
#     ran the bundler (build server, EAS, etc.).
#   - For secrets that must NEVER reach the client, store them in
#     Supabase Edge Function secrets or in your backend's vault.
# ============================================

# ============================================
# 🔴 CRITICAL - Required for App to Work
# ============================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ONLY the anon key is safe for client apps
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Razorpay Configuration
# Get these from: https://dashboard.razorpay.com/app/keys
# Only the key_id is safe to expose publicly
# Server secrets (RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET) go in
# Supabase Edge Function secrets, NOT here.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# Country Code Configuration
# Set your default country code (e.g., '+91' for India, '+1' for US)
EXPO_PUBLIC_COUNTRY_CODE=+91

# ============================================
# 🟡 IMPORTANT - Recommended for Production
# ============================================

# Agora Video Call Configuration (client-side only)
# Get the App ID from: https://console.agora.io
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Sentry Error Tracking (client-side)
# Get this from: https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# App version + build (used for Sentry release tracking)
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# EAS Project ID (for push notifications)
# Set after running: eas init
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ============================================
# 🟢 OPTIONAL - External APIs
# ============================================
#
# All variables below this line are SERVER-SIDE ONLY.
# They are NOT exposed to the client bundle because they
# lack the EXPO_PUBLIC_ prefix. They are available only in
# the build/EAS/Supabase Edge Function runtime.
#
# Use them through an Edge Function, never in the app.

# Prokerala API (for accurate astrology calculations)
# Get these from: https://api.prokerala.com
PROKERALA_API_KEY=your-prokerala-api-key
PROKERALA_API_SECRET=your-prokerala-api-secret

# Swiss Ephemeris API (alternative)
SWISS_EPHEMERIS_API_KEY=your-swiss-ephemeris-key

# Vedic Astro API (alternative)
VEDIC_ASTRO_API_KEY=your-vedic-astro-api-key

# Apple App Store Server API (server-side only; set as Supabase Edge Function
# secrets for verify-iap-purchase). Create the key in App Store Connect >
# Users and Access > Integrations > App Store Server API.
APPLE_BUNDLE_ID=com.astronemi.astronemi
APPLE_ISSUER_ID=your-app-store-issuer-id
APPLE_KEY_ID=your-app-store-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Set true only in staging/development for sandbox purchases.
APPLE_ALLOW_SANDBOX=false

# Google Play Developer API (server-side only). Service account must have
# androidpublisher access and the app must be published to a track.
GOOGLE_PLAY_PACKAGE_NAME=com.astronemi.astronemi
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","token_uri":"https://oauth2.googleapis.com/token"}

# OpenAI (AI features only; leave unset in v1 production)
# Used by the ai-chat and interpret-dream Edge Functions. Those functions are
# not deployed for the v1 launch, so this secret is intentionally absent.
OPENAI_API_KEY=

# ============================================
# App Configuration (client-side)
# ============================================

EXPO_PUBLIC_APP_NAME="AstroNemi"
EXPO_PUBLIC_APP_SCHEME=astronemi

# Reviewer access (test/review builds only; keep false in production).
# Configure the same number as a Supabase Auth test-OTP phone number.
EXPO_PUBLIC_REVIEW_MODE=false
EXPO_PUBLIC_REVIEW_PHONE=

# Support Contact (client-side)
EXPO_PUBLIC_SUPPORT_EMAIL=support@astronemi.app
EXPO_PUBLIC_SUPPORT_PHONE=+918000000000
EXPO_PUBLIC_SUPPORT_WHATSAPP=+918000000000

# Social Links (client-side)
EXPO_PUBLIC_FACEBOOK_URL=https://facebook.com/astronemi
EXPO_PUBLIC_INSTAGRAM_URL=https://instagram.com/astronemi
EXPO_PUBLIC_TWITTER_URL=https://twitter.com/astronemi
EXPO_PUBLIC_YOUTUBE_URL=https://youtube.com/astronemi

# ============================================
# Feature Flags (client-side)
# ============================================

EXPO_PUBLIC_ENABLE_CHAT=true
EXPO_PUBLIC_ENABLE_VIDEO_CALL=true
EXPO_PUBLIC_ENABLE_VOICE_CALL=true
EXPO_PUBLIC_ENABLE_WALLET=true
# Wallet/credit top-ups. Leave false until the App Store/Google Play products
# and verify-iap-purchase function are configured. When false, existing credits
# remain spendable but top-ups are disabled (no Razorpay fallback).
EXPO_PUBLIC_ENABLE_IAP=false
EXPO_PUBLIC_ENABLE_SUBSCRIPTION=true
EXPO_PUBLIC_ENABLE_REFERRAL=true
EXPO_PUBLIC_ENABLE_SHOP=true
EXPO_PUBLIC_ENABLE_BLOG=true
EXPO_PUBLIC_ENABLE_COURSES=true
EXPO_PUBLIC_ENABLE_PODCASTS=true
EXPO_PUBLIC_ENABLE_COMMUNITY=true

# Master AI switch. v1 production MUST be false (or unset). Development and
# staging may set true to test AstroBot, AI Guru, and dream AI. The AI code
# stays in the repo either way; production also does not deploy the
# ai-chat/interpret-dream Edge Functions and does not set OPENAI_API_KEY.
EXPO_PUBLIC_ENABLE_AI_FEATURES=false

# ============================================
# Payment Configuration (client-side)
# ============================================

EXPO_PUBLIC_DEFAULT_CURRENCY=INR
EXPO_PUBLIC_CURRENCY_SYMBOL=₹
EXPO_PUBLIC_MIN_WALLET_TOPUP=100
EXPO_PUBLIC_MAX_WALLET_TOPUP=50000
EXPO_PUBLIC_MIN_CONSULTATION_DURATION=5

# ============================================
# Subscription Plans (client-side)
# ============================================

EXPO_PUBLIC_BASIC_PLAN_PRICE=299
EXPO_PUBLIC_PREMIUM_PLAN_PRICE=599
EXPO_PUBLIC_ELITE_PLAN_PRICE=999

# ============================================
# Referral Configuration (client-side)
# ============================================

EXPO_PUBLIC_REFERRAL_BONUS=100
EXPO_PUBLIC_MIN_WITHDRAWAL=500

# ============================================
# Cache Configuration (server-side, for Edge Functions)
# ============================================

CACHE_TTL_HOROSCOPE=3600
CACHE_TTL_PANCHANGE=86400
CACHE_TTL_ASTROLOGERS=300

# ============================================
# Development Settings (MUST be false in production)
# ============================================

# HIGH-1 fix: the dev mock is OFF by default. Set to "true" only
# in .env.development, never in .env.production. Money code never
# fakes state.
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_NETWORK_LOGGING=false

# ============================================
# Environment
# ============================================

# Environment: development, staging, production
# CRITICAL: Set to 'production' for production builds
EXPO_PUBLIC_APP_ENV=production
