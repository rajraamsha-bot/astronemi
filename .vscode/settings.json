{
    "typescript.autoClosingTags": false,
    "deno.enable": true,
    "deno.unstable": true,
    "deno.enablePaths": [
        "backend/supabase/functions"
    ],
    "kiroAgent.enableCodebaseIndexing": true,
    "kiroAgent.enableDebugLogs": true,
    "kiroAgent.enableTabAutocomplete": true,
    "kiroAgent.notifications.agent.failure": true,
    "kiroAgent.notifications.agent.success": true,
    "gitlens.ai.openInAgent": "agent",
    "kiroAgent.trust.defaultPattern": "full"
}